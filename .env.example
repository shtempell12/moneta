# Copy to .env and change the passwords: cp .env.example .env
APP_ENV=dev

POSTGRES_USER=moneta
POSTGRES_PASSWORD=change-me
POSTGRES_DB=moneta

# "db" is the service name in docker-compose.yml; "+psycopg" selects the driver for SQLAlchemy
DATABASE_URL=postgresql+psycopg://moneta:change-me@db:5432/moneta

# Tests run from the host machine, so the database is reached via localhost
TEST_DATABASE_URL=postgresql+psycopg://moneta:change-me@localhost:5432/moneta_test
